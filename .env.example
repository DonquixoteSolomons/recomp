# Only needed for the optional laptop version (app.py). The phone app in docs/
# keeps its keys in its own Settings screen, and the Renpho login for the nightly
# job lives in the private data repo's GitHub Secrets, not here.

RENPHO_EMAIL=you@example.com
RENPHO_PASSWORD=your-renpho-health-password

# The laptop version's photo estimator uses the Anthropic API (paid). Leave unset
# if you only use the phone app.
# ANTHROPIC_API_KEY=sk-ant-...
